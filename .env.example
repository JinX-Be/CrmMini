APP_NAME="Mini CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- Niche ---
# Active niche when resolving from config (Phase 0-4).
# Phase 5 will resolve this from the hostname/subdomain instead.
NICHE=window_cleaning

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Local dev: SQLite (zero-config).
DB_CONNECTION=sqlite

# Production (Render + Neon Postgres): set these instead.
# DB_CONNECTION=pgsql
# Paste the full Neon connection string (it already includes ?sslmode=require):
# DB_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
#
# Or configure individual values instead of DB_URL:
# DB_HOST=ep-xxxx.eu-central-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=dbname
# DB_USERNAME=user
# DB_PASSWORD=password
# DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# --- Mail (Phase 3/4: invoices + reminders) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS (Phase 4) ---
# SMS_DRIVER=log
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

VITE_APP_NAME="${APP_NAME}"
